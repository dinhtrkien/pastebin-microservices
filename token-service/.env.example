# .env.example for Token Service

# Port for the Token Service itself
TOKEN_SERVICE_PORT=3003

# URL for the Token Range Service (TRS)
TRS_URL=http://token-range-service:3001

# Redis connection details (match your docker-compose or deployment)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password # Uncomment if needed
